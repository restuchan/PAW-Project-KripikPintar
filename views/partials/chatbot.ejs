<div id="chatbot-config" data-wa="<%= whatsappNomor %>" hidden></div>

<button type="button" id="chatbot-tombol" data-buka-chatbot
        class="fixed bottom-5 right-5 z-40 inline-flex min-h-[3.5rem] items-center gap-2 rounded-full bg-hutan px-5 font-bold text-white shadow-xl hover:bg-daun focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-segar"
        aria-controls="chatbot-panel" aria-expanded="false">
  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
  Chatbot
</button>

<section id="chatbot-panel" hidden aria-label="Chatbot KripikPintar"
         class="fixed bottom-24 right-3 z-40 flex max-h-[75vh] w-[calc(100vw-1.5rem)] max-w-sm flex-col overflow-hidden rounded-2xl border border-garis bg-white shadow-2xl sm:right-5">
  <div class="flex items-center justify-between bg-daun px-4 py-3 text-white">
    <div>
      <p class="font-bold">Asisten KripikPintar</p>
      <p class="text-xs text-pucuk">Tanya harga, stok, rasa, atau cara pesan</p>
    </div>
    <button type="button" id="chatbot-tutup" class="rounded-full p-2 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emas" aria-label="Tutup chatbot">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div id="chatbot-pesan" class="flex-1 space-y-3 overflow-y-auto bg-kabut p-4" aria-live="polite"></div>

  <div id="chatbot-saran" class="flex flex-wrap gap-2 border-t border-garis bg-white px-4 pt-3">
    <button type="button" data-saran="Cara memesan" class="rounded-full border border-garis px-3 py-1.5 text-sm font-semibold text-hutan hover:bg-pucuk">Cara memesan</button>
    <button type="button" data-saran="Daftar harga" class="rounded-full border border-garis px-3 py-1.5 text-sm font-semibold text-hutan hover:bg-pucuk">Daftar harga</button>
    <button type="button" data-saran="Cek stok produk" class="rounded-full border border-garis px-3 py-1.5 text-sm font-semibold text-hutan hover:bg-pucuk">Cek stok</button>
    <button type="button" data-saran="Hubungi penjual" class="rounded-full border border-garis px-3 py-1.5 text-sm font-semibold text-hutan hover:bg-pucuk">Hubungi penjual</button>
  </div>

  <form id="chatbot-form" class="flex gap-2 bg-white p-4" autocomplete="off">
    <label for="chatbot-input" class="sr-only">Tulis pertanyaan</label>
    <input id="chatbot-input" type="text" maxlength="200" placeholder="Tulis pertanyaanmu..."
           class="min-h-[2.75rem] flex-1 rounded-full border-2 border-[#9db8a8] px-4 text-base placeholder:text-lumut focus:border-segar focus:outline-none focus:ring-4 focus:ring-segar/20">
    <button type="submit" class="btn-primary btn-kecil">Kirim</button>
  </form>
</section>

<script src="/js/chatbot.js"></script>
