  <a href="#konten"
     class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-daun focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
    Lewati ke konten utama
  </a>

  <header class="max-w-6xl mx-auto px-5 sm:px-8 py-5 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 text-xl font-extrabold tracking-tight text-daun">
      <svg viewBox="0 0 40 40" class="h-9 w-9" aria-hidden="true">
        <circle cx="20" cy="20" r="20" fill="#1f6b45"/>
        <ellipse cx="20" cy="17" rx="11" ry="7" fill="#f0bd3c" transform="rotate(-8 20 17)"/>
        <path d="M8 20h24c0 7-5 11-12 11S8 27 8 20z" fill="#12372a"/>
      </svg>
      KripikPintar
    </a>

    <% if (!locals.tanpaNav && user) { %>
      <nav class="flex flex-wrap items-center gap-2" aria-label="Navigasi utama">
        <a href="/" class="nav-link">Beranda</a>
        <% if (user.role === 'pemilik') { %>
          <a href="/produk/baru" class="nav-link">+ Tambah Produk</a>
        <% } else { %>
          <button type="button" data-buka-chatbot class="nav-link">Chatbot</button>
          <button type="button" id="tombol-keranjang" class="nav-link gap-2" aria-label="Buka keranjang belanja">
            Keranjang
            <span id="jumlah-keranjang" class="inline-flex h-6 min-w-[1.5rem] items-center justify-center rounded-full bg-hutan px-1.5 text-xs font-bold text-white">0</span>
          </button>
        <% } %>
        <span class="hidden sm:inline-flex items-center rounded-full bg-pucuk px-3 py-2 text-sm font-semibold text-hutan">
          <%= user.username %> &middot; <%= user.role === 'pemilik' ? 'Pemilik' : 'Pembeli' %>
        </span>
        <form action="/auth/logout" method="post">
          <button type="submit" class="nav-link">Keluar</button>
        </form>
      </nav>
    <% } %>
  </header>
