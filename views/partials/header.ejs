  <a href="#konten"
     class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-hutan focus:text-krim focus:px-4 focus:py-2 focus:rounded-lg">
    Lewati ke konten utama
  </a>

  <header class="relative z-30 mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 text-hutan">
      <svg viewBox="0 0 40 40" class="h-9 w-9" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5" fill="#f5b71c" stroke="#1a1608" stroke-width="3"/>
        <circle cx="20" cy="20" r="10" fill="#fff8e4" stroke="#1a1608" stroke-width="3"/>
        <circle cx="20" cy="20" r="2.5" fill="#1a1608"/>
      </svg>
      <span class="judul text-2xl">KripikPintar</span>
    </a>

    <% if (!locals.tanpaNav && user) { %>
      <nav class="flex flex-wrap items-center gap-x-1 gap-y-2" aria-label="Navigasi utama">
        <a href="/" class="nav-link">Beranda</a>
        <% if (user.role === 'pemilik') { %>
          <a href="/produk/baru" class="nav-link">+ Tambah Produk</a>
        <% } else { %>
          <button type="button" data-buka-chatbot class="nav-link">Chatbot</button>
          <button type="button" id="tombol-keranjang" class="nav-link gap-2 border-2 border-hutan bg-krim" aria-label="Buka keranjang belanja">
            Keranjang
            <span id="jumlah-keranjang" class="inline-flex h-6 min-w-[1.5rem] items-center justify-center rounded-full bg-hutan px-1.5 text-sm font-bold text-krim">0</span>
          </button>
        <% } %>
        <span class="kecil-kap hidden items-center rounded-full border-2 border-hutan/30 px-3 py-1.5 text-sm text-daun sm:inline-flex">
          <%= user.username %> &middot; <%= user.role === 'pemilik' ? 'Pemilik' : 'Pembeli' %>
        </span>
        <form action="/auth/logout" method="post">
          <button type="submit" class="nav-link bg-hutan px-5 text-krim hover:bg-tinta hover:no-underline">Keluar</button>
        </form>
      </nav>
    <% } %>
  </header>
