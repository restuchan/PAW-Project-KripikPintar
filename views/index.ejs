<%- include('partials/head', { judul: judul }) %>
<body class="bg-kabut font-sans text-tinta antialiased">
<%- include('partials/header') %>
<% const pemilik = user.role === 'pemilik'; %>

  <!-- Ikon doodle dekoratif (dipakai ulang lewat <use>) -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <symbol id="d-daun" viewBox="0 0 48 48">
      <path d="M7 41C7 19 21 6 43 6c0 23-13 35-36 35z" fill="#58a94b" stroke="#1a1608" stroke-width="3" stroke-linejoin="round"/>
      <path d="M7 41L31 17" fill="none" stroke="#1a1608" stroke-width="3" stroke-linecap="round"/>
    </symbol>
    <symbol id="d-irisan" viewBox="0 0 48 48">
      <circle cx="24" cy="24" r="20" fill="#fff8e4" stroke="#1a1608" stroke-width="3"/>
      <circle cx="24" cy="24" r="12" fill="#f5b71c" stroke="#1a1608" stroke-width="3"/>
      <circle cx="24" cy="24" r="3" fill="#1a1608"/>
    </symbol>
  </svg>

  <main id="konten">
    <!-- Hero -->
    <%
      const heroFoto = produk.filter(function (p) { return p.foto; }).slice(0, 4);
      const heroTile = heroFoto.length ? heroFoto : [null, null, null];
      const heroGaya = ['-rotate-6 translate-y-6', 'rotate-3 -translate-y-2', '-rotate-3 translate-y-10', 'rotate-6 translate-y-1'];
    %>
    <section class="relative isolate overflow-hidden pb-16 pt-2 sm:pb-24">
      <p aria-hidden="true" class="judul pointer-events-none absolute inset-x-0 top-2 -z-10 select-none text-center text-[19vw] leading-none text-daun">Kripik</p>

      <svg class="absolute left-[6%] top-[34%] h-9 w-9 -rotate-12 sm:h-14 sm:w-14" aria-hidden="true"><use href="#d-daun"/></svg>
      <svg class="absolute right-[7%] top-[12%] h-8 w-8 rotate-12 sm:h-12 sm:w-12" aria-hidden="true"><use href="#d-irisan"/></svg>
      <svg class="absolute right-[10%] top-[48%] h-9 w-9 -scale-x-100 rotate-12 sm:h-14 sm:w-14" aria-hidden="true"><use href="#d-daun"/></svg>
      <svg class="absolute left-[11%] top-[8%] h-7 w-7 sm:h-10 sm:w-10" aria-hidden="true"><use href="#d-irisan"/></svg>

      <div class="mx-auto mt-[9vw] flex max-w-6xl items-end justify-center gap-2 px-5 sm:gap-6">
        <% heroTile.forEach(function (p, i) { %>
          <div class="aspect-square w-[20vw] max-w-[13rem] shrink-0 overflow-hidden rounded-2xl border-[3px] border-tinta bg-krim shadow-[0_10px_0_rgba(26,22,8,0.18)] sm:rounded-3xl <%= heroGaya[i % heroGaya.length] %>">
            <% if (p) { %>
              <img src="<%= p.foto %>" alt="" class="h-full w-full object-cover" aria-hidden="true">
            <% } else { %>
              <%- include('partials/placeholder') %>
            <% } %>
          </div>
        <% }); %>
      </div>

      <div class="mx-auto mt-16 max-w-4xl px-5 text-center sm:mt-24 sm:px-8">
        <h1 class="judul text-3xl text-hutan sm:text-5xl lg:text-6xl">
          <%= pemilik ? 'Kelola produk dan buat caption dalam sekali klik.' : 'Kripik buah khas Malang, renyah dari kebun.' %>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-lumut">
          <% if (pemilik) { %>
            Halo, <%= user.username %>. Tambah, ubah, atau hapus produk, lalu buat caption promosinya dengan bantuan AI.
          <% } else { %>
            Halo, <%= user.username %>. Pilih kripik favoritmu, masukkan ke keranjang, lalu pesan lewat WhatsApp.
          <% } %>
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <% if (pemilik) { %>
            <a href="/produk/baru" class="btn-primary">Buat Caption Baru</a>
            <a href="#produk" class="btn-ghost">Lihat Produk</a>
          <% } else { %>
            <a href="#produk" class="btn-primary">Lihat Produk</a>
            <button type="button" data-buka-chatbot class="btn-ghost">Tanya Chatbot</button>
          <% } %>
        </div>
      </div>
    </section>
    <div class="h-2 bg-segar" aria-hidden="true"></div>

    <!-- Daftar produk (dari database) -->
    <section id="produk" class="scroll-mt-6 pb-0 pt-14" aria-labelledby="judul-produk">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 sm:flex-row sm:items-end sm:justify-between sm:px-8">
        <div>
          <h2 id="judul-produk" class="judul text-4xl text-hutan sm:text-5xl">Produk Kami</h2>
          <p class="kecil-kap mt-3 text-lg text-lumut"><%= produk.length %> produk dari database</p>
        </div>
        <% if (pemilik) { %>
          <a href="/produk/baru" class="btn-ghost">+ Tambah Produk</a>
        <% } %>
      </div>

      <% if (!produk.length) { %>
        <div class="mx-auto mt-8 max-w-7xl px-5 pb-16 sm:px-8">
          <div class="rounded-3xl border-2 border-dashed border-hutan/40 bg-krim p-10 text-center text-lumut">
            Belum ada produk.<% if (pemilik) { %> Tekan &quot;+ Tambah Produk&quot; untuk memulai.<% } %>
          </div>
        </div>
      <% } else { %>
        <% const warna = ['bg-rasa1', 'bg-rasa2', 'bg-rasa3', 'bg-rasa4']; %>
        <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4">
          <% produk.forEach(function (p, i) { %>
            <li class="relative flex flex-col overflow-hidden px-6 pb-8 pt-6 <%= warna[i % 4] %>">
              <p class="kecil-kap text-base text-tinta">Rasa <%= String(i + 1).padStart(2, '0') %></p>

              <div class="relative mx-auto mt-5 w-full max-w-[16rem]">
                <svg class="absolute -left-3 -top-4 z-10 h-8 w-8 sm:-left-4 sm:h-10 sm:w-10" aria-hidden="true"><use href="#d-irisan"/></svg>
                <svg class="absolute -right-3 top-1/2 z-10 h-9 w-9 rotate-12 sm:-right-4 sm:h-11 sm:w-11 <%= i % 2 ? '-scale-x-100' : '' %>" aria-hidden="true"><use href="#d-daun"/></svg>
                <div class="aspect-square w-full overflow-hidden rounded-3xl border-[3px] border-tinta bg-krim shadow-[0_10px_0_rgba(26,22,8,0.18)] <%= i % 2 ? 'rotate-2' : '-rotate-2' %>">
                  <% if (p.foto) { %>
                    <img src="<%= p.foto %>" alt="<%= p.nama %>" class="h-full w-full object-cover" loading="lazy">
                  <% } else { %>
                    <%- include('partials/placeholder') %>
                  <% } %>
                </div>
              </div>

              <div class="mt-8 flex flex-1 flex-col">
                <h3 class="judul break-words text-2xl text-hutan"><%= p.nama %></h3>
                <p class="mt-3 flex-1 text-base text-tinta/80"><%= p.deskripsi || p.keunggulan || '' %></p>
                <div class="mt-5 flex flex-wrap items-end justify-between gap-3">
                  <p class="judul text-2xl text-hutan"><%= p.hargaFormat %></p>
                  <% if (p.stok < 1) { %>
                    <p class="kecil-kap rounded-full bg-bata px-3 py-1 text-sm text-white">Stok habis</p>
                  <% } else if (p.stok < 15) { %>
                    <p class="kecil-kap rounded-full bg-tinta px-3 py-1 text-sm text-krim">Stok menipis: <%= p.stok %></p>
                  <% } else { %>
                    <p class="kecil-kap text-sm text-tinta">Stok <%= p.stok %></p>
                  <% } %>
                </div>

                <% if (pemilik) { %>
                  <a href="/produk/<%= p.id %>/caption" class="btn-primary mt-4">Buat Caption</a>
                  <div class="mt-3 grid grid-cols-2 gap-3">
                    <a href="/produk/<%= p.id %>/edit" class="btn-ghost btn-kecil">Edit</a>
                    <button type="button" class="btn-bahaya btn-kecil bg-krim/60" data-hapus="<%= p.id %>" data-nama="<%= p.nama %>">Hapus</button>
                  </div>
                <% } else { %>
                  <button type="button" class="btn-primary mt-4" data-tambah="<%= p.id %>" <%= p.stok < 1 ? 'disabled' : '' %>>
                    <%= p.stok < 1 ? 'Stok habis' : '+ Keranjang' %>
                  </button>
                <% } %>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <!-- Ajakan pesan lewat WhatsApp -->
    <section class="relative isolate overflow-hidden bg-daun px-5 py-20 text-center text-krim sm:px-8 sm:py-28">
      <svg class="absolute left-[7%] top-[14%] h-10 w-10 -rotate-12 sm:h-16 sm:w-16" aria-hidden="true"><use href="#d-daun"/></svg>
      <svg class="absolute right-[8%] top-[10%] h-9 w-9 rotate-12 sm:h-14 sm:w-14" aria-hidden="true"><use href="#d-irisan"/></svg>
      <svg class="absolute bottom-[12%] left-[10%] h-9 w-9 sm:h-12 sm:w-12" aria-hidden="true"><use href="#d-irisan"/></svg>
      <svg class="absolute bottom-[14%] right-[9%] h-10 w-10 -scale-x-100 rotate-12 sm:h-16 sm:w-16" aria-hidden="true"><use href="#d-daun"/></svg>
      <div class="relative mx-auto max-w-4xl">
        <h2 class="judul text-4xl sm:text-6xl lg:text-7xl">Ingin memesan kripik?</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-pucuk">Hubungi kami lewat WhatsApp untuk pemesanan, ongkir, dan pertanyaan lainnya.</p>
        <a href="https://wa.me/<%= whatsappNomor %>?text=<%= encodeURIComponent('Halo, saya ingin memesan kripik dari KripikPintar.') %>"
           target="_blank" rel="noopener"
           class="btn mt-8 min-h-[3.5rem] border-krim bg-krim px-9 text-xl text-daun hover:bg-emas hover:border-emas">Pesan via WhatsApp</a>
      </div>
    </section>

    <!-- Tentang kami -->
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8" aria-labelledby="judul-tentang">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="aspect-[4/3] -rotate-2 overflow-hidden rounded-3xl border-[3px] border-tinta shadow-[8px_8px_0_#1a1608]">
          <%- include('partials/placeholder') %>
        </div>
        <div>
          <h2 id="judul-tentang" class="judul text-4xl text-hutan sm:text-5xl">Tentang kami</h2>
          <p class="mt-5 text-lg text-lumut">
            KripikPintar adalah usaha keluarga di Malang yang mengolah buah-buahan segar menjadi kripik renyah.
            Setiap kemasan dibuat dengan sepenuh hati, dan kini pemesanannya jadi lebih mudah dengan bantuan teknologi.
          </p>
        </div>
      </div>
    </section>
  </main>

  <% if (pemilik) { %>
    <script src="/js/beranda-pemilik.js"></script>
  <% } else { %>
    <script type="application/json" id="data-produk"><%- JSON.stringify(produk.map(function (p) { return { id: p.id, nama: p.nama, harga: p.harga, stok: p.stok }; })).replace(/</g, '\\u003c') %></script>
    <%- include('partials/keranjang') %>
    <%- include('partials/chatbot') %>
  <% } %>

<%- include('partials/footer') %>
